{
  "name": "taylor-swift-song-ranker",
  "version": "1.0.0",
  "description": "An application to rank favorite Taylor Swift songs.",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "serve": "npx http-server public -c-1",
  "open-ui": "npx http-server public -p 8081 -c-1 & sleep 0.2 && open http://localhost:8081",
    "build": "tsc",
    "test": "jest",
    "rank": "ts-node src/ranker.ts",
    "rank:simulate": "SIMULATE=1 ts-node src/ranker.ts"
  },
  "dependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0"
  },
  "author": "Your Name",
  "license": "MIT"
}